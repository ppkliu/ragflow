# AgentWiki 的 RAGFlow 部署範本：覆寫官方 docker/.env 的少數設定。
#
# 怎麼用：不必手動複製。部署包裡它叫 agentwiki.env.example，gen-env.sh（load.sh 會自動呼叫）
# 在 docker/.env 還不存在時，以官方範本（docker/.env.example）為底、套上這裡列的值建立它，
# 再把留空的帳密自動產生成隨機值。docker/.env 一旦存在，這個檔案就不會再被讀取。
#
# 規則：
#   - 有值的行：原樣寫進 docker/.env。
#   - 帳密留空：gen-env.sh 產生 24 字元的隨機英數字。要指定自己的值，直接填在這裡。
#   - 沒列在這裡的設定：沿用官方 docker/.env 的預設值。
#
# ★ 資料庫、搜尋引擎、物件儲存與管理員的密碼只在「第一次啟動、資料初始化」時生效，之後再改
#   只會造成連線失敗。gen-env.sh 偵測到這個 project 已經有資料 volume 時，不會改任何帳密。

# ---------------------------------------------------------------------------
# 跟既有的 RAGFlow 0.x 並存
# ---------------------------------------------------------------------------
# 1.0 的 compose 沒有寫死 container_name，所以只要 compose project 名稱不同，容器、volume、
# network 就互不相干；剩下會撞的只有 host 對外埠號。這裡列的埠號全部只用在 host 端
# （容器之間一律用服務名稱加固定的容器內埠號連線），改了不影響內部連線。
# 主機上沒有舊版、想用官方預設埠號時，部署前把對應行刪掉或改回即可。

COMPOSE_PROJECT_NAME=ragflow-v100

# Web（nginx）與 API（官方預設 80 / 443 / 9380 / 9381）
SVR_WEB_HTTP_PORT=18080
SVR_WEB_HTTPS_PORT=18443
SVR_HTTP_PORT=19380
ADMIN_SVR_HTTP_PORT=19381

# 相依服務的 host 埠號（官方預設 1200 / 3306 / 9000 / 9001 / 6379 / 4222 / 8222）
ES_PORT=11200
EXPOSE_MYSQL_PORT=13306
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
KVROCKS_PORT=26379
EXPOSE_NATS_PORT=14222
EXPOSE_NATS_MONITORING_PORT=18222

# ---------------------------------------------------------------------------
# 帳號密碼（留空 = gen-env.sh 自動產生）
# ---------------------------------------------------------------------------
# 官方範本的預設值是公開的 infini_rag_flow / admin，不能用在網路可達的主機上。

# Elasticsearch（使用者固定是 elastic）
ELASTIC_PASSWORD=
# MySQL（root 與 RAGFlow 共用這個密碼）
MYSQL_PASSWORD=
# MinIO（物件儲存，存放上傳的原始檔）
MINIO_USER=rag_flow
MINIO_PASSWORD=
# Kvrocks（Redis 相容的快取與佇列）
REDIS_PASSWORD=

# 第一個超級管理員：第一次啟動時建立，用來登入 Web（18080）與 Admin（19381），
# 也是產生 kb-stack 用的 API key 的帳號。改 email 要在第一次啟動前改。
DEFAULT_SUPERUSER_EMAIL=admin@ragflow.io
DEFAULT_SUPERUSER_PASSWORD=
