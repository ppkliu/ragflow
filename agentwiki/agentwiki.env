# AgentWiki 部署覆寫值：load.sh 第一次建立 docker/.env 時套用（之後不會再覆寫）。
#
# 目的：讓 1.0 跟既有的 RAGFlow 0.x 並存在同一台主機。1.0 的 compose 沒有寫死
# container_name，所以只要 compose project 名稱不同，容器、volume、network 就
# 互不相干；剩下會撞的只有 host 對外埠號。這裡列的埠號全部只用在 host 端
# （容器之間一律用服務名稱加固定的容器內埠號連線），改了不影響內部連線。
#
# 主機上沒有舊版、想用官方預設埠號時，部署前把這個檔案的對應行刪掉或改回即可。

COMPOSE_PROJECT_NAME=ragflow-v100

# Web（nginx）與 API
SVR_WEB_HTTP_PORT=18080
SVR_WEB_HTTPS_PORT=18443
SVR_HTTP_PORT=19380
ADMIN_SVR_HTTP_PORT=19381

# 相依服務的 host 埠號（官方預設 1200 / 3306 / 9000 / 9001 / 6379 / 4222 / 8222）
ES_PORT=11200
EXPOSE_MYSQL_PORT=13306
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
KVROCKS_PORT=26379
EXPOSE_NATS_PORT=14222
EXPOSE_NATS_MONITORING_PORT=18222
